# Copy to .env and fill in. Never commit .env.

COMPOSE_PROJECT_NAME=aco

# Domains — Timeweb / acoedu.ru
WP_DOMAIN=www.acoedu.ru
MOODLE_DOMAIN=learn.acoedu.ru
COOKIE_DOMAIN=.acoedu.ru
WP_HOME=https://www.acoedu.ru
WP_SITEURL=https://www.acoedu.ru
MOODLE_WWWROOT=https://learn.acoedu.ru
# Public IPv4 of this VPS so WordPress and Moodle can call each other
ACO_PUBLIC_IP=89.223.125.72

# WordPress
WP_ENVIRONMENT_TYPE=production
WORDPRESS_DEBUG=0
ACO_ENABLE_COD_PLACEHOLDER=0
WORDPRESS_DB_NAME=db_wordpress
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=change-me-wp
WORDPRESS_TABLE_PREFIX=wp_

# Generate at https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY=put-unique-phrase-here
WORDPRESS_SECURE_AUTH_KEY=put-unique-phrase-here
WORDPRESS_LOGGED_IN_KEY=put-unique-phrase-here
WORDPRESS_NONCE_KEY=put-unique-phrase-here
WORDPRESS_AUTH_SALT=put-unique-phrase-here
WORDPRESS_SECURE_AUTH_SALT=put-unique-phrase-here
WORDPRESS_LOGGED_IN_SALT=put-unique-phrase-here
WORDPRESS_NONCE_SALT=put-unique-phrase-here

# Moodle DB
MOODLE_DB_NAME=db_moodle
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASSWORD=change-me-moodle
MOODLE_SSLPROXY=1

# MariaDB
MYSQL_ROOT_PASSWORD=change-me-root

# Redis (leave empty locally)
WP_REDIS_PASSWORD=change-me-redis
MOODLE_REDIS_PASSWORD=change-me-redis

# Mail — Unisender Go on production (fill SMTP_USER / SMTP_PASS in the Go cabinet).
# Local `docker-compose.yml` uses Mailpit unless you set SMTP_* in `.env`.
SMTP_HOST=smtp.go1.unisender.ru
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM=no-reply@acoedu.ru
MAIL_FROM_NAME=АЦО — Академия цифрового образования
# Inbox for contacts form; partners form uses MAIL_PARTNERS or falls back here.
MAIL_INBOX=inbox@acoedu.ru
MAIL_PARTNERS=partners@acoedu.ru
