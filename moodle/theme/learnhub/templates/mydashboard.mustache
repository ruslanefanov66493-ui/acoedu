{{!
    @template theme_learnhub/mydashboard

    LearnHub custom dashboard layout with left course panel.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}


<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    <header class="lh-md-topbar d-print-none">
        <div class="lh-md-topbar__inner">
            <a class="lh-md-topbar__logo" href="{{{ myurl }}}" aria-label="АЦО">
                <img src="{{{ acologo }}}" alt="Логотип АЦО">
            </a>

            <div class="lh-md-topbar__user">
                {{#loggedin}}
                    <span class="lh-md-topbar__avatar" aria-hidden="true">{{ userinitials }}</span>
                    <a class="lh-md-topbar__userlink" href="{{{ profileurl }}}">{{ username }}</a>
                {{/loggedin}}
            </div>
        </div>
    </header>

    {{! Add minimal drawer structure for Boost JavaScript compatibility }}
    <div id="theme_boost-drawers-courseindex" class="drawer drawer-left" style="display: none !important;"></div>
    <div id="theme_boost-drawers-blocks" class="drawer drawer-right" style="display: none !important;"></div>

    <div id="page" data-region="mainpage" class="container-fluid d-print-block">
        {{! Minimal drawer toggles for Boost JavaScript - hidden with inline styles }}
        <div class="drawer-toggles d-flex" style="display: none !important;">
            <div class="drawer-toggler drawer-left-toggle">
                <button class="btn" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-courseindex"></button>
            </div>
            <div class="drawer-toggler drawer-right-toggle">
                <button class="btn" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-blocks"></button>
            </div>
        </div>

        <div id="page-content" class="row pb-3 d-print-block lh-mdash">
            <aside class="lh-mdash__sidebar d-print-none" aria-label="Навигация по кабинету">
                <a class="lh-mdash__item {{#isdashboard}}lh-mdash__item--active{{/isdashboard}}" href="{{{ myurl }}}">Панель</a>
                <a class="lh-mdash__item {{#ismycourses}}lh-mdash__item--active{{/ismycourses}}" href="{{{ mycoursesurl }}}">Мои курсы</a>
                <a class="lh-mdash__item" href="{{{ profileurl }}}">Профиль</a>
                <a class="lh-mdash__item" href="{{{ logouturl }}}">Выход</a>
            </aside>

            <div id="region-main-box" class="col lh-mdash__main">
                <section id="region-main" aria-label="{{#str}}content{{/str}}">
                    {{{ output.main_content }}}
                    {{{ output.activity_navigation }}}
                    {{{ output.course_content_footer }}}
                </section>
            </div>
        </div>
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>

{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
    Drawer.init();
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
